# ============================================================================
# .env.example - copy to .env and fill in your values. Never commit .env.
#
# The public page and the admin app read the VITE_* variables at BUILD time
# (Vite inlines them). The anon key is safe to expose: row level security
# decides what it can read. See supabase/migrations/0002_rls.sql.
# ============================================================================

# Supabase project (Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Server-side only. The service role key bypasses RLS: use it in local scripts
# only, never in frontend code, never in git.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Used by scripts/bootstrap-admin.mjs and scripts/verify-cms.mjs
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=your-strong-password

# Public origin, used to resolve relative image paths during migration.
SITE_URL=https://example.com
